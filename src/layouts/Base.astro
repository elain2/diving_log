---
import '../styles/global.css';
import { SITE } from '../../site.config.mjs';
import { href, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** 언어와 상관없는 경로 (예: 'gallery', 'dives/2026-08-20') — 언어 전환 링크에 씀 */
  path: string;
  title?: string;
  description?: string;
  image?: string;
}
const { lang, path, title, description, image } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const desc = description ?? (lang === 'ko' ? '숨 참고 내려간 날들의 기록' : 'Days I held my breath and went down');
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const nav = [
  { key: 'log', path: '' },
  { key: 'gallery', path: 'gallery' },
  { key: 'about', path: 'about' },
] as const;
const current = path.split('/')[0] === 'dives' ? '' : path;
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#e4edeb" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <link rel="alternate" hreflang={other} href={href(other, path)} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&family=Shippori+Mincho:wght@500;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      try {
        if (localStorage.getItem('theme') === 'night') document.documentElement.dataset.theme = 'night';
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main">{lang === 'ko' ? '본문으로' : 'Skip to content'}</a>
    <header class="top wrap">
      <a class="brand latin" href={href(lang)}>{SITE.name}</a>
      <nav aria-label="main">
        {nav.map((n) => (
          <a href={href(lang, n.path)} aria-current={current === n.path ? 'page' : undefined}>{t(lang, n.key)}</a>
        ))}
      </nav>
      <div class="tools small">
        <a href={href(other, path)} hreflang={other} lang={other}>{other.toUpperCase()}</a>
        <button class="night" type="button" aria-pressed="false" title={t(lang, 'night')}>
          <span class="sr-only">{t(lang, 'night')}</span>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot wrap small mute">
      <span class="latin">© {SITE.name}</span>
      {SITE.instagram && <a href={`https://instagram.com/${SITE.instagram}`} rel="me noopener" target="_blank">instagram</a>}
    </footer>

    <dialog class="lightbox" aria-label="photo">
      <button class="lb-close small" type="button">{t(lang, 'close')}</button>
      <button class="lb-nav lb-prev" type="button" aria-label="previous">‹</button>
      <figure class="lb-frame">
        <img alt="" />
        <figcaption class="small"></figcaption>
      </figure>
      <button class="lb-nav lb-next" type="button" aria-label="next">›</button>
    </dialog>

    <script>
      // 밤 모드
      const root = document.documentElement;
      const nightBtn = document.querySelector<HTMLButtonElement>('.night')!;
      const syncNight = () => nightBtn.setAttribute('aria-pressed', String(root.dataset.theme === 'night'));
      syncNight();
      nightBtn.addEventListener('click', () => {
        const next = root.dataset.theme === 'night' ? '' : 'night';
        if (next) root.dataset.theme = next;
        else delete root.dataset.theme;
        try { localStorage.setItem('theme', next); } catch {}
        syncNight();
      });

      // 천천히 떠오름
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px 120px 0px' },
      );
      document.querySelectorAll('.rise').forEach((el) => io.observe(el));

      // 사진 크게 보기
      const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
      const img = dlg.querySelector('img')!;
      const cap = dlg.querySelector('figcaption')!;
      let list: HTMLElement[] = [];
      let idx = 0;
      const show = (i: number) => {
        idx = (i + list.length) % list.length;
        const el = list[idx];
        img.src = el.dataset.full!;
        img.alt = el.dataset.alt ?? '';
        cap.textContent = el.dataset.caption ?? '';
      };
      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest<HTMLElement>('[data-full]');
        if (!el) return;
        list = [...document.querySelectorAll<HTMLElement>('[data-full]')].filter((n) => n.offsetParent !== null);
        show(list.indexOf(el));
        dlg.showModal();
      });
      dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(idx - 1));
      dlg.querySelector('.lb-next')!.addEventListener('click', () => show(idx + 1));
      dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(idx - 1);
        if (e.key === 'ArrowRight') show(idx + 1);
      });
      let x0: number | null = null;
      dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      dlg.addEventListener('touchend', (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
        x0 = null;
      });
    </script>

    <style>
      .top { display: flex; align-items: center; gap: 12px 32px; padding-block: 26px 18px; }
      .brand { font-size: 1.15rem; font-weight: 800; text-decoration: none; margin-right: auto; letter-spacing: 0.01em; }
      nav { display: flex; gap: 26px; font-family: var(--mincho); font-weight: 700; font-size: 0.95rem; }
      nav a { text-decoration: none; color: var(--mute); transition: color 0.2s; }
      nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
      .tools { display: flex; align-items: center; gap: 14px; }
      .tools a { text-decoration: none; color: var(--mute); }
      .tools a:hover { color: var(--ink); }
      .night { border: 0; background: none; padding: 4px; cursor: pointer; color: var(--mute); display: grid; }
      .night:hover, .night[aria-pressed='true'] { color: var(--ink); }

      .foot { display: flex; justify-content: center; gap: 18px; padding-block: 90px 40px; }
      .foot a { text-decoration: none; }

      .lightbox {
        border: 0; padding: 0; margin: auto;
        width: 100vw; height: 100dvh; max-width: none; max-height: none;
        background: transparent; color: #d0e5e5;
        display: none;
      }
      .lightbox[open] { display: grid; grid-template-columns: 64px 1fr 64px; align-items: center; }
      .lightbox::backdrop { background: rgba(12, 18, 17, 0.94); }
      .lb-frame { margin: 0; justify-self: center; display: grid; gap: 12px; max-width: 100%; }
      .lb-frame img { max-height: calc(100dvh - 110px); width: auto; margin: auto; }
      .lb-frame figcaption { text-align: center; color: #9fb8b4; font-family: var(--mincho); }
      .lb-nav, .lb-close { background: none; border: 0; color: inherit; cursor: pointer; }
      .lb-nav { font-size: 2.4rem; height: 100%; opacity: 0.55; font-family: var(--mincho); }
      .lb-nav:hover { opacity: 1; }
      .lb-close { position: fixed; top: 18px; right: 22px; z-index: 2; opacity: 0.7; }

      @media (max-width: 760px) {
        .top { flex-wrap: wrap; padding-block: 18px 12px; gap: 6px 18px; }
        nav { order: 3; width: 100%; gap: 22px; }
        .lightbox[open] { grid-template-columns: 1fr; }
        .lb-nav { position: fixed; bottom: 12px; height: auto; }
        .lb-prev { left: 18px; }
        .lb-next { right: 18px; }
      }
    </style>
  </body>
</html>
