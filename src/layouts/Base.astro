---
import '../styles/global.css';
import { SITE } from '../../site.config.mjs';
import { href, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** 언어와 상관없는 경로 (예: 'gallery', 'dives/2026-08-20') — 언어 전환 링크에 씀 */
  path: string;
  title?: string;
  description?: string;
  image?: string;
}
const { lang, path, title, description, image } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — dive log`;
const desc = description ?? (lang === 'ko' ? '바다와 수영장에서 숨 참고 내려간 날들의 기록' : 'Notes from holding my breath in the sea and the pool');
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const nav = [
  { key: 'log', path: '' },
  { key: 'gallery', path: 'gallery' },
  { key: 'about', path: 'about' },
] as const;
const current = path.split('/')[0] === 'dives' ? '' : path;
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <link rel="alternate" hreflang={other} href={href(other, path)} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&family=Gaegu:wght@400;700&family=Gowun+Dodum&family=Nanum+Pen+Script&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'night') document.documentElement.dataset.theme = 'night';
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main">{lang === 'ko' ? '본문으로' : 'Skip to content'}</a>
    <header class="top wrap">
      <a class="brand" href={href(lang)}>
        <span class="brand-name pen">{SITE.name}</span>
        <span class="stamp rect brand-tag">dive log</span>
      </a>
      <nav aria-label="main">
        {nav.map((n) => (
          <a href={href(lang, n.path)} class="nav-link hand" aria-current={current === n.path ? 'page' : undefined}>
            {t(lang, n.key)}
          </a>
        ))}
      </nav>
      <div class="tools">
        <a class="lang-sticker type" href={href(other, path)} hreflang={other} lang={other}>
          <span class:list={{ on: lang === 'ko' }}>KO</span>/<span class:list={{ on: lang === 'en' }}>EN</span>
        </a>
        <button class="night" type="button" aria-pressed="false" title={t(lang, 'night')}>
          <span class="sr-only">{t(lang, 'night')}</span>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="wrap foot hand">
      <span>© {SITE.name}</span>
      <span aria-hidden="true">· · ·</span>
      {SITE.instagram && <a href={`https://instagram.com/${SITE.instagram}`} rel="me noopener" target="_blank">instagram</a>}
    </footer>

    <dialog class="lightbox" aria-label="photo">
      <button class="lb-close" type="button" aria-label={t(lang, 'close')}>×</button>
      <button class="lb-nav lb-prev" type="button" aria-label="previous">‹</button>
      <figure class="lb-frame">
        <img alt="" />
        <figcaption class="hand"></figcaption>
      </figure>
      <button class="lb-nav lb-next" type="button" aria-label="next">›</button>
    </dialog>

    <script>
      // 밤 다이빙 모드
      const root = document.documentElement;
      const nightBtn = document.querySelector<HTMLButtonElement>('.night')!;
      const syncNight = () => nightBtn.setAttribute('aria-pressed', String(root.dataset.theme === 'night'));
      syncNight();
      nightBtn.addEventListener('click', () => {
        const next = root.dataset.theme === 'night' ? '' : 'night';
        if (next) root.dataset.theme = next;
        else delete root.dataset.theme;
        try { localStorage.setItem('theme', next); } catch {}
        syncNight();
      });

      // 스크롤하면 사진이 내려앉음
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px 120px 0px' },
      );
      document.querySelectorAll('.settle').forEach((el) => io.observe(el));

      // 사진 크게 보기
      const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
      const img = dlg.querySelector('img')!;
      const cap = dlg.querySelector('figcaption')!;
      let list: HTMLElement[] = [];
      let idx = 0;
      const show = (i: number) => {
        idx = (i + list.length) % list.length;
        const el = list[idx];
        img.src = el.dataset.full!;
        img.alt = el.dataset.alt ?? '';
        cap.textContent = el.dataset.caption ?? '';
      };
      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest<HTMLElement>('[data-full]');
        if (!el) return;
        list = [...document.querySelectorAll<HTMLElement>('[data-full]')].filter((n) => n.offsetParent !== null);
        show(list.indexOf(el));
        dlg.showModal();
      });
      dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(idx - 1));
      dlg.querySelector('.lb-next')!.addEventListener('click', () => show(idx + 1));
      dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(idx - 1);
        if (e.key === 'ArrowRight') show(idx + 1);
      });
      let x0: number | null = null;
      dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      dlg.addEventListener('touchend', (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
        x0 = null;
      });
    </script>

    <style>
      .top {
        display: flex;
        align-items: center;
        gap: 12px 28px;
        flex-wrap: wrap;
        padding-block: 22px 10px;
      }
      .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; margin-right: auto; }
      .brand-name { font-size: 2.1rem; line-height: 1; letter-spacing: 0.01em; }
      .brand-tag { font-size: 0.7rem; --tilt: -6deg; }
      nav { display: flex; gap: 20px; }
      .nav-link { font-size: 1.35rem; text-decoration: none; position: relative; }
      .nav-link[aria-current='page']::after,
      .nav-link:hover::after {
        content: '';
        position: absolute;
        left: -4px; right: -4px; bottom: 2px;
        height: 9px;
        background: var(--tape);
        z-index: -1;
        rotate: -1.5deg;
      }
      .tools { display: flex; align-items: center; gap: 10px; }
      .lang-sticker {
        display: inline-block;
        background: var(--card);
        box-shadow: var(--shadow);
        padding: 3px 10px;
        font-size: 0.85rem;
        text-decoration: none;
        rotate: 3deg;
        border-radius: 3px;
        color: var(--ink-soft);
      }
      .lang-sticker .on { color: var(--red); font-weight: 700; }
      .night {
        border: 0; background: none; cursor: pointer; padding: 6px; border-radius: 50%;
        display: grid; place-items: center;
      }
      .night[aria-pressed='true'] { color: var(--tape); }
      .foot {
        display: flex; gap: 12px; justify-content: center;
        padding-block: 80px 40px; color: var(--ink-soft); font-size: 1.15rem;
      }

      .lightbox {
        border: 0; padding: 0; margin: auto;
        width: 100vw; height: 100dvh; max-width: none; max-height: none;
        background: transparent;
        display: none;
      }
      .lightbox[open] { display: grid; grid-template-columns: 64px 1fr 64px; align-items: center; }
      .lightbox::backdrop { background: rgba(8, 14, 26, 0.9); backdrop-filter: blur(4px); }
      .lb-frame {
        margin: 0; justify-self: center;
        background: #fffdf8; padding: 12px 12px 0;
        box-shadow: 0 30px 60px -20px #000;
        max-width: 100%;
      }
      .lb-frame img { max-height: calc(100dvh - 140px); width: auto; margin: auto; }
      .lb-frame figcaption { color: #55617d; font-size: 1.2rem; padding: 8px 4px 12px; min-height: 44px; }
      .lb-nav, .lb-close {
        background: none; border: 0; color: #f4ede0; cursor: pointer;
        font-size: 3rem; line-height: 1; padding: 8px; height: 100%;
      }
      .lb-close { position: fixed; top: 10px; right: 16px; height: auto; font-size: 2.4rem; z-index: 2; }

      @media (max-width: 640px) {
        .top { padding-block: 16px 4px; }
        .top { flex-wrap: wrap; gap: 6px 12px; }
        .brand { min-width: 0; }
        .brand-name { font-size: 1.6rem; white-space: nowrap; }
        .brand-tag { display: none; }
        nav { order: 3; width: 100%; gap: 18px; }
        .lightbox[open] { grid-template-columns: 1fr; }
        .lb-nav { position: fixed; bottom: 12px; height: auto; }
        .lb-prev { left: 16px; }
        .lb-next { right: 16px; }
        .lb-frame { padding: 6px 6px 0; }
      }
    </style>
  </body>
</html>
