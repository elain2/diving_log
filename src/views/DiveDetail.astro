---
// 다이빙 하루: 글은 짧게, 사진은 격자로, 날짜와 제목은 가사처럼 세로로
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Lyric from '../components/Lyric.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import YouTube from '../components/YouTube.astro';
import type { Dive } from '../lib/dives';
import { t, href, formatDate, type Lang } from '../lib/i18n';

interface Props { lang: Lang; dive: Dive; prev?: Dive; next?: Dive }
const { lang, dive, prev, next } = Astro.props;
const d = dive.data;
const { Content } = await render(dive.bodyEntry);

const facts = [
  `${t(lang, d.place)} · ${d.discipline ?? t(lang, d.type)}`,
  d.maxDepth !== undefined ? `${t(lang, 'maxDepth')} ${d.maxDepth}m` : undefined,
  d.time ? `${t(lang, 'time')} ${d.time}` : undefined,
  d.waterTemp !== undefined ? `${t(lang, 'water')} ${d.waterTemp}°C` : undefined,
  d.visibility !== undefined ? `${t(lang, 'vis')} ${d.visibility}m` : undefined,
  dive.buddy ? `${t(lang, 'buddy')} ${dive.buddy}` : undefined,
].filter(Boolean);
const caption = [formatDate(d.date, lang, 'stamp'), dive.location].filter(Boolean).join(' · ');
---

<Base lang={lang} path={`dives/${dive.id}`} title={dive.title} image={dive.cover?.src.src}>
  <div class="wrap layout">
    <article class="main">
      <header class="caption">
        {dive.deck && <p class="deck mincho">{dive.deck}</p>}
        <div class="body mincho">
          {lang === 'en' && !dive.hasEnglish && <p class="small mute">(written in Korean)</p>}
          <Content />
        </div>
        <p class="facts small">
          {facts.map((f, i) => <>{i > 0 && <span class="dot">·</span>}{f}</>)}
          {d.draft && <><span class="dot">·</span><span class="draft">{t(lang, 'draft')}</span></>}
        </p>
      </header>

      {(dive.clips.length > 0 || d.youtube.length > 0) && (
        <section class="films" aria-label={t(lang, 'videos')}>
          {dive.clips.map((c) => <video src={c.src} poster={c.poster?.src} autoplay muted loop playsinline preload="metadata" aria-label={t(lang, 'moving')} />)}
          {d.youtube.map((id) => <YouTube id={id} label={dive.title} />)}
        </section>
      )}

      <PhotoGrid photos={dive.photos} title={dive.title} caption={caption} eagerCount={6} />

      <nav class="pager small" aria-label="dives">
        {prev ? <a href={href(lang, `dives/${prev.id}`)}>‹ <span class="mincho">{prev.title}</span> <span class="mute">{formatDate(prev.data.date, lang, 'stamp')}</span></a> : <span />}
        {next && <a href={href(lang, `dives/${next.id}`)}><span class="mute">{formatDate(next.data.date, lang, 'stamp')}</span> <span class="mincho">{next.title}</span> ›</a>}
      </nav>
    </article>

    <aside class="side">
      <Lyric
        as="h1"
        title={dive.title}
        date={d.date}
        lines={[dive.location, d.maxDepth !== undefined ? `${d.maxDepth}m` : undefined]}
        lang={lang}
        size="lg"
      />
    </aside>
  </div>
</Base>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(32px, 6vw, 96px); padding-top: 28px; }
  .main { max-width: 935px; width: 100%; justify-self: center; }
  .side { position: sticky; top: 40px; align-self: start; padding-top: 8px; }

  .caption { max-width: 620px; padding: 8px 0 34px; }
  .deck { font-weight: 800; font-size: 1.15rem; margin: 0 0 14px; }
  .body { font-size: 1rem; line-height: 2; color: var(--ink); }
  .body :global(p) { margin: 0 0 1em; }
  .body :global(strong) { font-weight: 800; }
  .body :global(blockquote) { margin: 1.4em 0; padding-left: 1em; border-left: 2px solid var(--teal); color: var(--ink-2); font-weight: 700; }
  .body :global(a) { color: var(--teal); }
  .facts { margin: 18px 0 0; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 2px 0; }
  .dot { margin: 0 8px; color: var(--mute); }
  .draft { color: var(--teal); }

  /* 세로 영상은 높이를 제한해서 나란히, 가로 영상은 폭에 맞게 */
  .films { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gap); margin-bottom: var(--gap); }
  .films video { width: auto; max-width: 100%; height: auto; max-height: min(72vh, 600px); background: #000; }

  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 48px; padding-top: 16px; border-top: 1px solid var(--rule); }
  .pager a { text-decoration: none; }
  .pager a:hover .mincho { color: var(--teal); }

  @media (max-width: 1000px) {
    .layout { grid-template-columns: 1fr; gap: 8px; }
    .side { position: static; order: -1; justify-self: end; padding-inline: 16px; }
    .side :global(.l-title) { max-height: 46vh; }
  }
  @media (max-width: 760px) {
    .layout { width: 100%; }
    .caption, .pager { padding-inline: 16px; }
  }
</style>
