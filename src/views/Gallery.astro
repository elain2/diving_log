---
// 사진: 롤(다이빙 하루 / 일상 폴더)마다 격자 + 옆에 세로글
import Base from '../layouts/Base.astro';
import Lyric from '../components/Lyric.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import DateIndex from '../components/DateIndex.astro';
import { getRolls } from '../lib/rolls';
import { t, href, formatDate, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const rolls = await getRolls(lang);

const all = rolls.flatMap((r) => r.photos.map((p) => ({ r, p })));
const counts = {
  all: all.length,
  picks: all.filter((x) => x.p.isPick).length,
  diving: all.filter((x) => x.r.kind === 'dive').length,
  daily: all.filter((x) => x.r.kind === 'daily').length,
  me: all.filter((x) => x.p.isMe).length,
};
const filters = (['all', 'picks', 'diving', 'daily', 'me'] as const).filter((k) => k === 'all' || counts[k] > 0);
const label = (k: (typeof filters)[number]) => (k === 'all' ? (lang === 'ko' ? '전체' : 'All') : t(lang, k));
---

<Base lang={lang} path="gallery" title={t(lang, 'gallery')}>
  <div class="wrap page">
    <div class="tabs top-tabs" role="group" aria-label={t(lang, 'filter')}>
      {filters.map((k, i) => (
        <button type="button" class="tab" data-filter={k} aria-pressed={i === 0 ? 'true' : 'false'}>
          {label(k)}<span class="n">{counts[k]}</span>
        </button>
      ))}
    </div>

    <DateIndex rolls={rolls} lang={lang} />

    {rolls.map((r, i) => (
      <section class="roll" id={`roll-${r.id}`} data-kind={r.kind}>
        <div class="grid-col">
          <PhotoGrid
            photos={r.photos}
            title={r.title}
            caption={formatDate(r.date, lang, 'stamp')}
            kind={r.kind === 'dive' ? 'diving' : 'daily'}
            eagerCount={i === 0 ? 6 : 0}
          />
          {r.logPath && <a class="go small" href={href(lang, r.logPath)}>{lang === 'ko' ? '이날의 기록' : 'Read this day'} ›</a>}
        </div>
        <aside class="side">
          <Lyric title={r.title} date={r.date} lang={lang} size="md" as="h2" />
        </aside>
      </section>
    ))}
  </div>
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab[data-filter]');
  const match = (el: HTMLElement, f: string) =>
    f === 'all' ||
    (f === 'picks' && el.dataset.pick === '1') ||
    (f === 'me' && el.dataset.me === '1') ||
    el.dataset.kind === f;
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      const f = tab.dataset.filter!;
      tabs.forEach((x) => x.setAttribute('aria-pressed', String(x === tab)));
      document.querySelectorAll<HTMLElement>('.pg li').forEach((el) => (el.hidden = !match(el, f)));
      document.querySelectorAll<HTMLElement>('.roll').forEach((s) => {
        s.hidden = !s.querySelector('.pg li:not([hidden])');
      });
      // 인덱스: 걸러진 롤만 남은 날은 흐리게
      cells.forEach((c) => {
        const ids = c.dataset.rolls!.split(' ');
        const shown = ids.filter((id) => !document.getElementById(`roll-${id}`)?.hidden);
        c.classList.toggle('off', shown.length === 0);
        if (shown.length) c.setAttribute('href', `#roll-${shown[0]}`);
      });
    }),
  );

  // 인덱스: 지금 보고 있는 롤의 칸에 테두리
  const cells = document.querySelectorAll<HTMLAnchorElement>('.dindex a.c[data-rolls]');
  const cellOf = new Map<string, HTMLAnchorElement>();
  cells.forEach((c) => c.dataset.rolls!.split(' ').forEach((id) => cellOf.set(id, c)));
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        cells.forEach((c) => c.classList.remove('here'));
        cellOf.get(e.target.id.replace(/^roll-/, ''))?.classList.add('here');
      }
    },
    { rootMargin: '-8% 0px -88% 0px' },
  );
  document.querySelectorAll('.roll').forEach((s) => io.observe(s));

  // 좁은 화면에선 최근 칸이 보이게 오른쪽 끝 쪽으로
  document.querySelectorAll<HTMLElement>('.dindex .scroll').forEach((s) => {
    const last = [...s.querySelectorAll<HTMLElement>('a.c')].pop();
    if (last && s.scrollWidth > s.clientWidth) s.scrollLeft = Math.max(0, last.offsetLeft - s.clientWidth + 48);
  });
</script>

<style>
  .page { max-width: 1060px; padding-top: 12px; }
  .top-tabs { border-top: 1px solid var(--rule); margin-bottom: 36px; }
  .roll { display: grid; grid-template-columns: minmax(0, 1fr) 112px; gap: clamp(20px, 4vw, 48px); margin-bottom: clamp(56px, 8vw, 96px); }
  .roll[hidden] { display: none; }
  .roll { scroll-margin-top: 24px; }
  .side { position: sticky; top: 32px; align-self: start; display: flex; justify-content: flex-start; }
  .go { display: inline-block; margin-top: 10px; text-decoration: none; color: var(--mute); }
  .go:hover { color: var(--ink); }

  @media (max-width: 760px) {
    .page { width: 100%; }
    .top-tabs { margin-inline: 16px; }
    .roll { grid-template-columns: minmax(0, 1fr) 64px; gap: 10px; }
    .side { top: 12px; padding-right: 8px; }
    .side :global(.lyric-md .l-title) { font-size: 1.1rem; }
    .side :global(.lyric-md .l-date) { font-size: 0.72rem; }
    .go { margin-left: 8px; }
  }
</style>
