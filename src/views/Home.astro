---
// 홈: 인스타그램처럼 프로필 + 격자. 오른쪽에는 가사처럼 세로글
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lyric from '../components/Lyric.astro';
import { SITE } from '../../site.config.mjs';
import { getDives, stats } from '../lib/dives';
import { getProfile } from '../lib/profile';
import { t, href, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dives = await getDives(lang);
const s = stats(dives);
const first = dives.at(-1)?.data.date;
const profile = await getProfile(lang);

const filters = [
  { key: 'all', label: lang === 'ko' ? '전체' : 'All', n: dives.length },
  { key: 'sea', label: t(lang, 'sea'), n: s.sea },
  { key: 'pool', label: t(lang, 'pool'), n: s.pool },
  { key: 'scuba', label: t(lang, 'scuba'), n: dives.filter((d) => d.data.type === 'scuba').length },
].filter((f) => f.key === 'all' || f.n > 0);
---

<Base lang={lang} path="" image={dives.find((d) => d.cover)?.cover?.src.src}>
  <div class="wrap layout">
    <div class="main">
      <section class="profile">
        <div class="avatar">
          {profile.photo && <Image src={profile.photo} alt={profile.name} widths={[160, 320]} sizes="140px" format="webp" loading="eager" />}
        </div>
        <div class="info">
          <h1 class="name latin">{SITE.name}</h1>
          <ul class="counts">
            <li><b>{s.days}</b> {lang === 'ko' ? '번의 다이빙' : 'dives'}</li>
            <li><b>{s.photos}</b> {lang === 'ko' ? '장의 사진' : 'photos'}</li>
            {s.deepest !== undefined && <li>{lang === 'ko' ? '최대' : 'deepest'} <b>{s.deepest}m</b></li>}
          </ul>
          {profile.tagline && <p class="bio mincho">{profile.tagline}</p>}
        </div>
      </section>

      <div class="tabs" role="group" aria-label={t(lang, 'filter')}>
        {filters.map((f, i) => (
          <button type="button" class="tab" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label}<span class="n">{f.n}</span>
          </button>
        ))}
      </div>

      <ul class="grid3 posts">
        {dives.filter((d) => d.cover).map((d, i) => (
          <li class="post rise" data-place={d.data.place} data-type={d.data.type}>
            <a class="tile" href={href(lang, `dives/${d.id}`)} aria-label={d.title}>
              <Image src={d.cover!.src} alt="" widths={[360, 720]} sizes="(max-width: 760px) 33vw, 300px" format="webp" quality={76} loading={i < 6 ? 'eager' : 'lazy'} />
              {d.photos.length > 1 && (
                <svg class="multi" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3" width="14" height="14" rx="1.5" /><path d="M3 7v12.5A1.5 1.5 0 0 0 4.5 21H17" /></svg>
              )}
              <span class="veil" aria-hidden="true">
                <Lyric title={d.title} date={d.data.date} lines={[d.data.maxDepth !== undefined ? `${d.data.maxDepth}m` : undefined]} lang={lang} size="sm" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <aside class="side" aria-hidden="true">
      <Lyric
        title={lang === 'ko' ? '숨 참고 내려간 날들' : 'the days I held my breath'}
        date={first}
        lines={[lang === 'ko' ? '부터 지금까지' : 'and on']}
        lang={lang}
        size="lg"
      />
    </aside>
  </div>
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab[data-filter]');
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      const f = tab.dataset.filter!;
      tabs.forEach((x) => x.setAttribute('aria-pressed', String(x === tab)));
      document.querySelectorAll<HTMLElement>('.post').forEach((el) => {
        el.hidden = f !== 'all' && el.dataset.place !== f && el.dataset.type !== f;
      });
    }),
  );
</script>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(32px, 6vw, 96px); padding-top: 28px; }
  .main { max-width: 935px; width: 100%; justify-self: center; }

  /* 프로필 */
  .profile { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: clamp(20px, 6vw, 72px); padding: 12px clamp(0px, 4vw, 48px) 40px; }
  .avatar { width: clamp(84px, 16vw, 150px); aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--paper-2); outline: 1px solid var(--rule); outline-offset: 4px; }
  .avatar :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .name { font-size: 1.5rem; font-weight: 800; margin: 0 0 14px; letter-spacing: 0.01em; }
  .counts { list-style: none; margin: 0 0 14px; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 28px; color: var(--ink-2); }
  .counts b { color: var(--ink); font-weight: 700; }
  .bio { margin: 0; font-weight: 700; font-size: 1rem; }

  .tabs { border-top: 1px solid var(--rule); margin-bottom: 4px; }
  .posts { list-style: none; margin: 0; padding: 0; }
  .post[hidden] { display: none; }

  /* 격자 사진 위 세로글 (마우스를 올리면) */
  .multi { position: absolute; top: 10px; right: 10px; width: 20px; height: 20px; fill: none; stroke: #fff; stroke-width: 1.6; filter: drop-shadow(0 0 2px rgba(0,0,0,.4)); }
  .veil {
    position: absolute; inset: 0;
    display: flex; justify-content: flex-end; align-items: flex-start;
    padding: 18px 16px;
    background: linear-gradient(to left, rgba(12, 49, 77, 0.62), rgba(12, 49, 77, 0.12) 70%);
    opacity: 0;
    transition: opacity 0.5s;
    --ink: #f2f7f6; --ink-2: #d0e5e5; --mute: #b9d0cd;
  }
  .tile:hover .veil, .tile:focus-visible .veil { opacity: 1; }
  .tile:hover .multi { opacity: 0; }

  /* 오른쪽 세로글 */
  .side { position: sticky; top: 40px; align-self: start; padding-top: 8px; }

  @media (max-width: 1000px) {
    .layout { grid-template-columns: 1fr; }
    .side { display: none; }
  }
  @media (max-width: 760px) {
    .layout { width: 100%; padding-top: 8px; }
    .profile { padding: 8px 16px 24px; gap: 20px; }
    .name { font-size: 1.2rem; margin-bottom: 8px; }
    .counts { gap: 2px 16px; font-size: 0.85rem; }
    .veil { display: none; }
  }
</style>
