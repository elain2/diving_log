---
// 나: 사진 한 장, 짧은 소개, 그리고 세로글
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lyric from '../components/Lyric.astro';
import { SITE } from '../../site.config.mjs';
import { getDives, stats } from '../lib/dives';
import { getProfile } from '../lib/profile';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const profile = await getProfile(lang);
const { Content } = await render(profile.entry);
const dives = await getDives(lang);
const s = stats(dives);
const first = dives.at(-1)?.data.date;
const ko = lang === 'ko';
---

<Base lang={lang} path="about" title={t(lang, 'about')}>
  <div class="wrap layout">
    <div class="main">
      {profile.photo && (
        <div class="portrait">
          <Image src={profile.photo} alt={profile.name} widths={[400, 800]} sizes="(max-width: 760px) 100vw, 420px" format="webp" loading="eager" />
        </div>
      )}
      <div class="text">
        {profile.tagline && <p class="tagline mincho">{profile.tagline}</p>}
        <div class="body mincho"><Content /></div>

        <p class="facts small">
          {s.days} {ko ? '번의 다이빙' : 'dives'}
          <span class="dot">·</span>{s.sea} {t(lang, 'sea')} / {s.pool} {t(lang, 'pool')}
          {s.deepest !== undefined && <><span class="dot">·</span>{ko ? '최대' : 'deepest'} {s.deepest}m</>}
        </p>

        <dl class="lists">
          {profile.certs.length > 0 && (
            <div>
              <dt class="small mute">{ko ? '자격' : 'Certifications'}</dt>
              {profile.certs.map((c) => <dd>{c.name}<span class="mute small">{[c.org, c.date].filter(Boolean).join(' · ')}</span></dd>)}
            </div>
          )}
          {profile.gear.length > 0 && (
            <div>
              <dt class="small mute">{ko ? '장비' : 'Gear'}</dt>
              {profile.gear.map((g) => <dd>{g}</dd>)}
            </div>
          )}
          {profile.favorites.length > 0 && (
            <div>
              <dt class="small mute">{t(lang, 'favorites')}</dt>
              {profile.favorites.map((f) => <dd>{f}</dd>)}
            </div>
          )}
        </dl>

        {SITE.instagram && (
          <p class="small"><a href={`https://instagram.com/${SITE.instagram}`} rel="me noopener" target="_blank">@{SITE.instagram}</a></p>
        )}
      </div>
    </div>

    <aside class="side">
      <Lyric as="h1" title={profile.name} date={first} lines={[ko ? '부터 바다에' : 'in the water since']} lang={lang} size="lg" />
    </aside>
  </div>
</Base>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(32px, 6vw, 96px); padding-top: 28px; }
  .main { display: grid; grid-template-columns: minmax(0, 420px) minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); max-width: 935px; width: 100%; justify-self: center; align-items: start; }
  .side { position: sticky; top: 40px; align-self: start; padding-top: 8px; }
  .portrait :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .tagline { font-weight: 800; font-size: 1.3rem; margin: 0 0 20px; }
  .body { line-height: 2; }
  .body :global(p) { margin: 0 0 1em; }
  .body :global(strong) { font-weight: 800; }
  .body :global(code) { font-family: var(--sans); font-size: 0.85em; background: var(--paper-2); padding: 1px 5px; }
  .facts { color: var(--ink-2); margin: 24px 0; padding-block: 12px; border-block: 1px solid var(--rule); }
  .dot { margin: 0 8px; color: var(--mute); }
  .lists { margin: 0; display: grid; gap: 22px; }
  .lists dt { margin-bottom: 6px; }
  .lists dd { margin: 0; font-family: var(--mincho); font-weight: 700; display: flex; flex-wrap: wrap; gap: 0 10px; align-items: baseline; }
  .text a { color: var(--teal); }

  @media (max-width: 1000px) {
    .layout { grid-template-columns: 1fr; }
    .side { display: none; }
  }
  @media (max-width: 760px) {
    .main { grid-template-columns: 1fr; }
  }
</style>
