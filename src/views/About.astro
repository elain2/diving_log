---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { getDives, stats } from '../lib/dives';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const entries = await getCollection('about');
const entry = entries.find((e) => e.id === lang) ?? entries.find((e) => e.id === 'ko')!;
const ko = entries.find((e) => e.id === 'ko')!;
const { Content } = await render(entry);
const dives = await getDives(lang);
const s = stats(dives);

const files = import.meta.glob<ImageMetadata>('/dives/*/photos/*', { eager: true, import: 'default' });
const photoPath = entry.data.photo ?? ko.data.photo;
const meFallback = dives.flatMap((d) => d.photos).find((p) => p.isMe) ?? dives.find((d) => d.cover)?.cover;
const photo = (photoPath && files[`/dives/${photoPath}`]) || meFallback?.src;
const certs = entry.data.certs.length ? entry.data.certs : ko.data.certs;
const stampTilts = [-8, 6, -3, 10, -12, 4];
---
<Base lang={lang} path="about" title={t(lang, 'about')}>
  <section class="wrap about">
    <div class="passport">
      <div class="pp-photo">
        <span class="tape corner-l teal" aria-hidden="true"></span>
        {photo && <Image src={photo} alt={entry.data.name} widths={[300, 600]} sizes="260px" format="webp" />}
      </div>
      <div class="pp-info">
        <span class="type pp-label">DIVER / 다이버</span>
        <h1 class="pen">{entry.data.name}</h1>
        {entry.data.tagline && <p class="hand tagline">{entry.data.tagline}</p>}
        <dl class="pp-stats type">
          <div><dt>{t(lang, 'diveDays')}</dt><dd>{s.days}</dd></div>
          {s.deepest !== undefined && <div><dt>{t(lang, 'deepest')}</dt><dd>{s.deepest}m</dd></div>}
          <div><dt>{t(lang, 'sea')} / {t(lang, 'pool')}</dt><dd>{s.sea} / {s.pool}</dd></div>
        </dl>
      </div>
      <p class="mrz type" aria-hidden="true">P&lt;DIVE&lt;&lt;FREE&lt;YOUNG&lt;510&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</p>
    </div>

    <div class="text ruled"><Content /></div>

    {certs.length > 0 && (
      <section class="certs">
        <h2 class="pen">{t(lang, 'certs')}</h2>
        <div class="stamps">
          {certs.map((c, i) => (
            <span class:list={['stamp', 'cert', { blue: i % 2 }]} style={`--tilt:${stampTilts[i % stampTilts.length]}deg`}>
              <span>{c.org && <small>{c.org}</small>}<b>{c.name}</b>{c.date && <small>{c.date}</small>}</span>
            </span>
          ))}
        </div>
      </section>
    )}

    {entry.data.favorites.length > 0 && (
      <section class="favs">
        <h2 class="pen">{t(lang, 'favorites')}</h2>
        <ul class="hand">{entry.data.favorites.map((f) => <li>{f}</li>)}</ul>
      </section>
    )}
  </section>
</Base>
<style>
  .about { max-width: 860px; padding-top: 30px; }
  .passport {
    display: grid; grid-template-columns: 220px 1fr; gap: 28px;
    background: var(--card); box-shadow: var(--shadow-lift); padding: 30px 30px 18px; rotate: -1deg;
    border-top: 10px solid var(--cover);
  }
  .pp-photo { position: relative; padding: 8px; background: var(--paper); box-shadow: var(--shadow); rotate: -3deg; align-self: start; }
  .pp-photo img { aspect-ratio: 3/4; object-fit: cover; width: 100%; }
  .pp-label { font-size: 0.72rem; letter-spacing: 0.2em; color: var(--ink-soft); }
  h1 { font-size: 3.4rem; font-weight: 400; margin: 0; line-height: 1.05; }
  .tagline { font-size: 1.35rem; margin: 4px 0 0; }
  .pp-stats { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 20px 0 0; }
  .pp-stats dt { font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); }
  .pp-stats dd { margin: 0; font-size: 1.6rem; font-weight: 700; color: var(--sea); }
  .mrz { grid-column: 1 / -1; margin: 6px 0 0; font-size: 0.85rem; letter-spacing: 0.18em; color: var(--ink-soft); overflow: hidden; white-space: nowrap; }
  .text { margin-top: 50px; font-size: 1.05rem; }
  .text :global(p) { margin: 0 0 2em; }
  h2 { font-size: 2.4rem; font-weight: 400; margin: 40px 0 14px; }
  .stamps { display: flex; flex-wrap: wrap; gap: 22px; }
  .cert { width: 150px; font-size: 0.66rem; }
  .cert b { display: block; font-size: 0.95rem; margin: 2px 0; }
  .cert small { display: block; font-size: 0.6rem; }
  .favs ul { font-size: 1.35rem; padding-left: 1.2em; margin: 0; columns: 2 220px; }
  @media (max-width: 640px) {
    .passport { grid-template-columns: 1fr; rotate: 0deg; padding: 22px; }
    .pp-photo { width: 60%; margin-inline: auto; }
    h1 { font-size: 2.6rem; }
    .cert { width: 128px; }
  }
</style>
