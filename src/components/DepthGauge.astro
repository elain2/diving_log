---
// 수심 게이지: 0m에서 최대 수심까지 내려간 선
interface Props { depth?: number; label: string }
const { depth, label } = Astro.props;
const scale = Math.max(10, Math.ceil(((depth ?? 0) + 2) / 10) * 10);
const H = 260;
const y = depth ? 20 + (depth / scale) * (H - 40) : 20;
const ticks = Array.from({ length: scale / 5 + 1 }, (_, i) => i * 5);
---
<figure class="gauge" aria-label={depth ? `${label} ${depth}m` : label}>
  <svg viewBox={`0 0 120 ${H}`} role="img" aria-hidden="true">
    <defs>
      <linearGradient id="deep" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#8fd0c9" />
        <stop offset=".55" stop-color="#1f6f8b" />
        <stop offset="1" stop-color="#0d1828" />
      </linearGradient>
    </defs>
    <rect x="40" y="20" width="22" height={H - 40} rx="11" fill="url(#deep)" opacity=".9" />
    <path d={`M30 20 q 5 -6 10 0 t 10 0 t 10 0 t 10 0 t 10 0`} fill="none" stroke="currentColor" stroke-width="1.5" opacity=".6" />
    {ticks.map((m) => {
      const ty = 20 + (m / scale) * (H - 40);
      return (
        <g opacity=".55">
          <line x1="64" x2={m % 10 === 0 ? 76 : 70} y1={ty} y2={ty} stroke="currentColor" stroke-width="1.2" />
          {m % 10 === 0 && <text x="80" y={ty + 4} font-size="11" font-family="Courier Prime, monospace" fill="currentColor">{m}m</text>}
        </g>
      );
    })}
    {depth && (
      <g class="diver">
        <line x1="51" x2="51" y1="20" y2={y} stroke="var(--red)" stroke-width="2.5" stroke-dasharray="4 4" />
        <circle cx="51" cy={y} r="7" fill="var(--red)" />
        <text x="2" y={y + 5} font-size="15" font-weight="700" font-family="Courier Prime, monospace" fill="var(--red)">{depth}</text>
      </g>
    )}
  </svg>
</figure>
<style>
  .gauge { margin: 0; width: 120px; color: var(--ink); }
  .diver line { animation: drop 1.4s cubic-bezier(.4,0,.2,1) .3s both; stroke-dashoffset: 0; }
  @keyframes drop { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
</style>
